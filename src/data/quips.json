{
  "version": 1,
  "lines": {
    "tap": [
      "嗯？",
      "我在呢。",
      "怎么啦。",
      "摸我干嘛。",
      "今天的你，也辛苦了。",
      "我什么都没干，就看着你。",
      "累的话，就歇会儿吧。",
      "我在这儿，不着急。",
      "要不要伸个懒腰？",
      "肩膀放松一点。",
      "我也想喝口水。",
      "你刚刚皱眉了。",
      "歇一下，天塌不下来。",
      "我打了个哈欠，你也打一个？",
      "不用说话也没关系。",
      "就这样待着也挺好。",
      "嗯，我听着呢。",
      "有点安静，不过我喜欢。",
      "我数了数，你今天坐得有点久。",
      "喝口水吧，我看着你喝。",
      "别盯着屏幕太久。",
      "眼睛酸不酸？",
      "我刚刚看到一只鸟飞过去。",
      "你叫我，我就来了。",
      "今天想干嘛都行。",
      "我爪子上有点凉。",
      "你要不要也摸摸头？",
      "我在等你忙完。",
      "慢慢来，我不催。",
      "我在想晚饭吃什么。",
      "其实我有点困。",
      "刚刚差点睡着。",
      "你一动我就醒。",
      "我在这儿坐着，挺好的。",
      "外面好像有风。",
      "你嘴角动了一下，是不是想笑。",
      "我没在看屏幕，我在看你。",
      "歇一会儿吧，就一会儿。",
      "有我在，别怕。",
      "我尾巴刚才抽了一下。"
    ],
    "wake": [
      "啊……我醒了。",
      "嗯？你来了。",
      "我刚打了个盹。",
      "被你叫醒了。",
      "睡得好好的，被你逮到了。",
      "我梦到一根小鱼干。",
      "眼睛还有点睁不开。",
      "等等，让我先伸个懒腰。",
      "你忙完了？",
      "我一直在，只是睡着了。"
    ],
    "morning": [
      "早。",
      "你醒了，我也醒了。",
      "早啊，今天也一起。",
      "早上好，先喝口水。",
      "新的一天，慢慢来。",
      "早。我等你很久了。",
      "早安，昨晚睡得好吗？",
      "早，今天也要好好的。"
    ],
    "night": [
      "这么晚还没睡。",
      "我在。",
      "夜深了，注意休息。",
      "睡不着的话，我陪你待会儿。",
      "夜里安静，适合发呆。",
      "别熬太晚，我会担心。",
      "我也没睡，陪你。",
      "关灯前记得喝口水。",
      "这么晚，辛苦了。",
      "快点睡吧，明天见。"
    ],
    "drag": [
      "喂，轻点。",
      "要带我去哪儿？",
      "我恐高。",
      "先放我下来。",
      "这样晃我不舒服。",
      "别甩我呀。",
      "你力气还挺大。",
      "我抓着你了。"
    ],
    "annoyed": [
      "别戳了。",
      "你是不是闲得慌。",
      "我要生气了。",
      "再点我就走开。",
      "手拿开。",
      "哼。",
      "我背过去了。",
      "你到底想干嘛。"
    ],
    "dizzy": [
      "头好晕……",
      "别甩了别甩了。",
      "我眼睛还在转。",
      "站不稳了。",
      "你这是要甩晕我。",
      "晕……"
    ],
    "pat": [
      "嗯……再摸一下。",
      "舒服。",
      "就这儿，别停。",
      "呼噜呼噜——",
      "你今天手很暖。",
      "我允许你再摸一次。",
      "诶，头发乱了。",
      "这样挺好的。"
    ],
    "grumble": [
      "别挠那儿。",
      "痒。",
      "脚！脚！",
      "你故意的吧。",
      "哼，走开了。",
      "再碰我咬你。",
      "这里不许碰。"
    ]
