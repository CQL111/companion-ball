# 复制为 .env 后填入真实值。`.env` 已被 gitignore。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 可选：electron-builder 发布 GitHub Release（私有仓库后不再用于分发）
# GH_TOKEN=

# ---------- S0-5 发布渠道：安装包发 R2，由站点下载页分发 ----------
# 账号 ID（Cloudflare 控制台 → R2 → 概览页可见）
CF_ACCOUNT_ID=
# R2 API Token（Object Read & Write，限定该桶）
# 创建：Cloudflare 控制台 → R2 → Manage R2 API Tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 桶名字（脚本在桶内写 releases/vX.Y.Z/... 与 latest.json）
R2_BUCKET=
# R2 公开域名（自定义域或 r2.dev 公开地址），下载页与 302 跳转都用它
# 例：https://download.example.com
R2_PUBLIC_BASE_URL=
# 站点正式域名（下载页 / API / 后台都挂它下面）
SITE_ORIGIN=
# 发版时上传到哪：r2（默认，站点分发）| github（仅内部记录）
PUBLISH_TARGET=r2
