{
  "name": "companion-ball",
  "version": "0.9.0",
  "private": true,
  "description": "桌面陪伴 · 团子猫（monorepo：桌面端 / 契约 / 服务端 / 网页 / 后台）",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @companion/desktop",
    "start": "npm run start -w @companion/desktop",
    "start:hidden": "npm run start:hidden -w @companion/desktop",
    "test": "npm test -w @companion/desktop && npm test -w @companion/contracts --if-present && npm test -w @companion/server && node scripts/check-admin-privacy.js",
    "test:e2e": "npm run test:e2e -w @companion/desktop",
    "test:all": "npm test && npm run build && npm run test:e2e",
    "typecheck": "npm run typecheck -w @companion/desktop && npm run typecheck -w @companion/contracts",
    "check:core": "node scripts/check-core-boundary.js",
    "check:server": "npm run typecheck -w @companion/server",
    "build": "npm run build -w @companion/desktop",
    "clean": "rimraf packages/desktop/out packages/desktop/out-release packages/desktop/out-release-key packages/desktop/out-public packages/desktop/release dist-public",
    "build:local": "npm run build:local -w @companion/desktop",
    "build:mac": "npm run build:mac -w @companion/desktop",
    "build:linux": "npm run build:linux -w @companion/desktop",
    "build:key": "npm run build:key -w @companion/desktop",
    "build:key:check": "npm run build:key:check -w @companion/desktop",
    "build:legal": "npm run build:legal -w @companion/desktop",
    "build:personal": "npm run build:personal -w @companion/desktop",
    "build:personal:mac": "npm run build:personal:mac -w @companion/desktop",
    "build:public": "npm run build:public -w @companion/desktop",
    "build:public:mac": "npm run build:public:mac -w @companion/desktop",
    "release": "node scripts/release.js",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "publish:r2": "node scripts/publish-r2.js",
    "build:skin": "npm run build:skin -w @companion/desktop",
    "pack:skin": "npm run pack:skin -w @companion/desktop",
    "build:site": "npm run build -w @companion/web",
    "mock:bottle": "node packages/server/scripts/mock-bottle-server.mjs",
    "dev:server": "npm run dev -w @companion/server",
    "deploy:server": "npm run deploy -w @companion/server",
    "test:e2e:build": "npm run build:e2e -w @companion/desktop",
    "test:e2e:all": "npm run build:e2e -w @companion/desktop && npm run test:e2e -w @companion/desktop && npm run test:e2e:all -w @companion/desktop",
    "build:platform": "npm run build -w @companion/web && npm run build -w @companion/admin && npm run build -w @companion/server",
    "test:platform": "node scripts/run-platform-e2e.mjs"
  },
  "keywords": [
    "electron",
    "desktop-pet",
    "companion",
    "desktop-widget"
  ],
  "author": {
    "name": "CQL111"
  },
  "license": "MIT",
  "devDependencies": {
    "dotenv": "^17.4.2",
    "standard-version": "^9.5.0"
  }
}
